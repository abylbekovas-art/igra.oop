import random
characters = [{ "name": "Алиса", "hints": ("Она любит читать книги", "Она любознательная") },{"name": "Боб", "hints": ("Он любит программирование", "Он увлекается играми") },{ "name": "Чарли", "hints": ("Он хорошо играет в футбол", "Он любит спорт") },{ "name": "Джек", "hints": ("Он любит путешествовать", "Он работает с компьютером")},{"name": "Эмили", "hints": ("Она любит рисовать", "Она увлекается музыкой") },{"name": "Фрэнк", "hints": ("Он любит готовить", "Он увлекается фотографией") },{"name": "Грейс", "hints": ("Она любит танцевать", "Она увлекается модой") },{"name": "Чарли", "hints": ("Он играет в футбол", "Он любит спорт") },{"name": "Джек", "hints": ("Он любит путешествовать", "Он работает с компьютером") },{"name": "Эмили", "hints": ("Она любит рисовать", "Она увлекается музыкой") },{"name": "Фрэнк", "hints": ("Он любит готовить", "Он увлекается фотографией") },{"name": "Грейс", "hints": ("Она любит танцевать", "Она увлекается модой") }]


def play_game():
    score = 0

    for round_number in range(1, 11):
        character = random.choice(characters)

        print(f"\nРаунд {round_number} из 10")
        print("Подсказка:", character["hints"][0])

        try:
            answer = input("Угадай персонажа: ").strip().capitalize()

            if answer == "":
                raise ValueError("Имя не должно быть пустым!")
            if answer == character["name"]:
                print("Правильно! Молодец!")
                score += 1
            else:
                print("Неправильно.")
                print("Правильный ответ:", character["name"])

        except ValueError as error:
            print("Ошибка:", error)

    print(f"\nИгра окончена! Твой результат: {score} из 10")

    def main():
        while True:
            print("\n=== УГАДАЙ ПЕРСОНАЖА ===")
            print("1. Начать игру")
            print("2. Выйти")

            try:
                choice = int(input("Выбери 1 или 2: " ))
                
                if choice == 1:
                    play_game()
                elif choice == 2:
                    print("Спасибо за игру!")
                    break
                else:
                    print("Введи 1 или 2!")

            except ValueError:
                print("Ошибка: Введи число 1 или 2!")

                main()